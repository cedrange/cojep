# Copiez ce fichier en ".env" et remplissez les valeurs avant de lancer le serveur.

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Session (générez une chaîne aléatoire longue, ex: openssl rand -hex 32) ---
SESSION_SECRET=change-me-please-use-a-long-random-string

# --- Compte admin (espace /admin) ---
# Générez le hash avec: npm run hash-password -- "votre-mot-de-passe"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Envoi d'email (SMTP) ---
# Exemple avec Gmail : host=smtp.gmail.com, port=587, secure=false, et un "mot de passe d'application"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=COJEP
MAIL_FROM_ADDRESS=
